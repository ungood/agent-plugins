{
  "name": "ungood",
  "owner": {
    "name": "Jason Walker"
  },
  "metadata": {
    "description": "Personal Claude plugin marketplace",
    "version": "1.0.0",
    "pluginRoot": "./plugins/"
  },
  "plugins": [
    {
      "name": "claude",
      "source": "./plugins/claude"
    },
    {
      "name": "cli",
      "source": "./plugins/cli"
    },
    {
      "name": "github",
      "source": "./plugins/github"
    },
    {
      "name": "markdown",
      "source": "./plugins/markdown"
    },
    {
      "name": "memex",
      "source": "./plugins/memex"
    },
    {
      "name": "nix",
      "source": "./plugins/nix"
    },
    {
      "name": "orca-sdlc",
      "source": "./plugins/orca-sdlc"
    },
    {
      "name": "todoist",
      "source": "./plugins/todoist"
    },
    {
      "name": "writing-style",
      "source": "./plugins/writing-style"
    },
    {
      "name": "orca",
      "description": "Skills for driving the Orca agent orchestrator, from stablyai/orca",
      "source": {
        "source": "git-subdir",
        "url": "stablyai/orca",
        "path": "skills"
      },
      "skills": [
        "./orca-cli",
        "./orchestration",
        "./orca-linear",
        "./computer-use"
      ]
    }
  ]
}
